# Copie este arquivo para ".env" e preencha sua chave da API da Anthropic (Claude).
# Pegue uma chave em: https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado como "cérebro" da E.V (opcional).
# Padrão: claude-opus-4-8 (mais capaz). Alternativas: claude-sonnet-5 (mais rápido/barato).
EV_MODEL=claude-opus-4-8

# Porta do servidor (opcional)
PORT=4123
